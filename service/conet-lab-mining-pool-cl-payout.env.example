# Copy to the daemon environment file (path per the deployment handover) on the daemon host.
# Secrets must be created on this host only; never copied off-host.
#
# LIMITED-EXECUTOR path ONLY:
#   Daemon → dedicated unix socket → LabMiningPoolPayoutExecutor.payout(amount)
# FORBIDDEN:
#   - CONET_LAB_MINING_POOL_CL_PAYOUT_ADMIN_PRIVATE_KEY(_FILE) / any pk → VDR.withdrawNative
#   - socket /run/wallet-signer-vdr/<claim-payout-socket>
#   - key array <claim-key-array>
#   - Lab EOA as VDR admins[]

# Keep 0 until owner enables production (fixture/keyless uses 0).
CONET_LAB_MINING_POOL_CL_PAYOUT=0
# Scan-only preserves pending and in-flight work without flushing, resuming or sending.
# To enable payouts, set the mode to payout explicitly in an approved restart.
CONET_LAB_MINING_POOL_CL_PAYOUT_MODE=scan-only

CONET_LAB_MINING_POOL_PUBKEYS_FILE=<service-home>/x402sdk/deployments/conet-lab-mining-pool-pubkeys.json
CONET_LAB_MINING_POOL_ADDRESS=0x32bE583C8e778FFfC5107BF34820c2B225336201
CONET_VALIDATOR_DEPOSIT_RPC_URL=https://publicrpc.conet.network
CONET_RPC_URL=https://publicrpc.conet.network
CONET_VALIDATOR_BEACON_REST_URL=http://127.0.0.1:4100

# --- Dedicated Lab payout signer (required for live PAYOUT=1) ---
CONET_LAB_MINING_POOL_CL_PAYOUT_SIGNER_SOCKET=<lab-payout-socket>
CONET_LAB_MINING_POOL_CL_PAYOUT_KEY_ARRAY=lab_mining_pool_payout
# Deployed LabMiningPoolPayoutExecutor (pending owner deploy + VDR addAdmin(executor))
# CONET_LAB_MINING_POOL_PAYOUT_EXECUTOR=0x…

CONET_LAB_MINING_POOL_CL_PAYOUT_TICK_MS=60000
CONET_LAB_MINING_POOL_CL_PAYOUT_CHUNK_BLOCKS=32
CONET_LAB_MINING_POOL_CL_PAYOUT_CHUNKS_PER_TICK=1
CONET_LAB_MINING_POOL_CL_PAYOUT_STATE_FILE=<service-home>/.conet-lab-mining-pool-cl-payout-state.json

CONET_LAB_MINING_POOL_DEPLOY_BLOCK=326705

# CONET_LAB_MINING_POOL_CL_PAYOUT_DRY_RUN=1
# CONET_LAB_MINING_POOL_CL_FULL_EXIT_FLOOR_WEI=1000000000000000000
# --- Gas: THREE VALUES MUST BE SET EXPLICITLY ---
# Deployment rule: do not rely on the code defaults. Set all three below, then check the startup log line
# "[labMiningPoolClPayout] starting ... maxGasGwei=0.03 ... gasWaitForceMs=300000 ... gasLimit=800000"
# and that each reports src=env. The short names in the review map to these full names:
#   MAX_GAS_PRICE_GWEI -> CONET_LAB_MINING_POOL_CL_PAYOUT_MAX_GAS_PRICE_GWEI
#   GAS_WAIT_FORCE_MS  -> CONET_LAB_MINING_POOL_CL_PAYOUT_GAS_WAIT_FORCE_MS
#   GAS_LIMIT          -> CONET_LAB_MINING_POOL_CL_PAYOUT_GAS_LIMIT
# Do not set
# CONET_LAB_MINING_POOL_CL_PAYOUT_MAX_GAS_PRICE_WEI here: a WEI value overrides the GWEI value.
CONET_LAB_MINING_POOL_CL_PAYOUT_MAX_GAS_PRICE_GWEI=0.03
CONET_LAB_MINING_POOL_CL_PAYOUT_GAS_WAIT_FORCE_MS=300000
CONET_LAB_MINING_POOL_CL_PAYOUT_GAS_LIMIT=800000
# In-flight age alert (B-2b). Candidate default 1800000 ms. It writes ALERT and counts; it never clears a record.

# Suggested executor constructor caps (PENDING OWNER REVIEW — not applied on-chain yet):
#   perTxCapWei         = 2 ether
#   cumulativeBudgetWei = 100 ether
