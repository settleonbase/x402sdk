# Install-time placeholders (<service-user>, <service-group>, <service-home>) are replaced from the private operations guide.
[Unit]
Description=Watch native reth payload progress and restart op-node on stall
After=network-online.target base-op-reth-native.service base-op-node-native.service
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
ExecStart=<service-home>/base/reth-payload-watchdog.sh
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
