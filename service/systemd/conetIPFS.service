# Install-time placeholders (<service-user>, <service-group>, <service-home>) are replaced from the private operations guide.
[Unit]
Description=CoNET IPFS fragment API (x402sdk fragmentDaemon, port 8002)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=<service-home>/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BEAMIO_YOUTUBE_MIRROR_CACHE_DIR=<service-home>/.data/beamio-youtube-mirror
ExecStart=/usr/bin/node <service-home>/x402sdk/dist/endpoint/fragmentDaemon.js
Restart=always
RestartSec=10
WorkingDirectory=<service-home>/x402sdk
User=<service-user>
Group=<service-group>
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=conet-ipfs

[Install]
WantedBy=multi-user.target
