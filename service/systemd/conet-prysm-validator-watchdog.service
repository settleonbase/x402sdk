# Install-time placeholders (<service-user>, <service-group>, <service-home>) are replaced from the private operations guide.
[Unit]
Description=Ensure CoNET Prysm validator client is running (node-0)
After=network-online.target conet-prysm-validator.service
Wants=conet-prysm-validator.service

[Service]
Type=oneshot
User=<service-user>
Group=<service-group>
WorkingDirectory=<service-home>/ethereum-pos-mainnet
EnvironmentFile=-/etc/default/conet-validator-redeem-listener
ExecStart=<service-home>/ethereum-pos-mainnet/09_ensure_validator_running.sh
