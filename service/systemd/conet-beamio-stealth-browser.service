# Install-time placeholders (<service-user>, <service-group>, <service-home>) are replaced from the private operations guide.
[Unit]
Description=Beamio stealth Chromium sidecar (localhost HTML fetch for bot-gated sites)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=<service-home>/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BEAMIO_STEALTH_BROWSER_PORT=17331
Environment=BEAMIO_STEALTH_BROWSER_CHANNEL=chrome
Environment=PLAYWRIGHT_BROWSERS_PATH=<service-home>/.cache/ms-playwright
ExecStart=/usr/bin/node <service-home>/x402sdk/dist/endpoint/stealthBrowserDaemon.js
Restart=always
RestartSec=10
WorkingDirectory=<service-home>/x402sdk
User=<service-user>
Group=<service-group>
MemoryMax=1536M
LimitNOFILE=65536
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=conet-beamio-stealth-browser

[Install]
WantedBy=multi-user.target
