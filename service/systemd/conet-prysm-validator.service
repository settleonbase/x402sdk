# Install-time placeholders (<service-user>, <service-group>, <service-home>) are replaced from the private operations guide.
[Unit]
Description=CoNET Prysm validator client (node-0)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
Group=<service-group>
WorkingDirectory=<service-home>/ethereum-pos-mainnet
EnvironmentFile=-/etc/default/conet-validator-redeem-listener
ExecStart=<service-home>/ethereum-pos-mainnet/10_run_prysm_validator.sh
Restart=always
RestartSec=10
TimeoutStopSec=120
StandardOutput=append:<service-home>/ethereum-pos-mainnet/network/node-0/logs/validator.log
StandardError=append:<service-home>/ethereum-pos-mainnet/network/node-0/logs/validator.log
SyslogIdentifier=conet-prysm-validator
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
