# Drop-in for Beamio Master (conet-beamio-api.service) on conet.network.
# Copy to /etc/default/conet-gb-depin-airdrop-cron and source from the Master unit:
#
#   sudo cp conet-gb-depin-airdrop-cron.env.example /etc/default/conet-gb-depin-airdrop-cron
#   sudo systemctl edit conet-beamio-api.service
#   # [Service]
#   # EnvironmentFile=-/etc/default/conet-gb-depin-airdrop-cron
#   sudo systemctl daemon-reload && sudo systemctl restart conet-beamio-api.service
#
# Master uses ~/.master.json settle_contractAdmin (4 wallets) via Settle_ContractPool.
# Each must be GBDepinAirdrop.addAdmin (see deployments/conet-GBDepinAirdrop.json).

CONET_GB_DEPIN_AIRDROP=0xBBd504a88dB1EA143A1D3a83E331F979dD3A5e44
CONET_GB_DEPIN_AIRDROP_CRON=1
CONET_GB_DEPIN_AIRDROP_CRON_MS=60000
CONET_GB_DEPIN_AIRDROP_PAGE_SIZE=100
