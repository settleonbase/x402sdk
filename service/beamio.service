# Install-time placeholders (<service-user>, <service-group>, <service-home>) are replaced from the private operations guide.
[Unit]
Description=CONET SI Process
After=network.target

[Service]
Type=simple
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node dist/src/endpoint/BeamioCluster.js
Restart=always
RestartSec=10

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=conet-si
WorkingDirectory=<service-home>/x402sdk
User=<service-user>
Group=<service-group>

[Install]
WantedBy=multi-user.target