# SITE CONFIGURATION TEMPLATE - placeholders only. Copy it OUTSIDE the repository on the host (for example next to the window directory), fill in the host's real values from the private ops guide,
# keep it private (owner root, mode 0600: the scripts read it through sudo and refuse any other owner or mode), and run the scripts with SITE_ENV=<that file>. Only these NAME=value lines are accepted (no code, no other name).
# A value that is empty or still contains < or > makes site_verify refuse to run.
DROPIN_A_NAME="<file name of the first extra drop-in the unit already has>"
DROPIN_B_NAME="<file name of the second extra drop-in>"
DROPIN_C_NAME="<file name of the third extra drop-in>"
REL_BASE="<directory that holds one sub-directory per release>"
DUNIT="<the Lab payout systemd unit name>"
DROPDIR="<the unit's drop-in directory>"
D6ENV="<the Lab environment file the unit loads>"
ENV0="<the unit's default environment file>"
SD="<the Lab payout v2 state directory>"
LOC="<local RPC URL of the node on this host>"
SVC_UID="<numeric uid of the service user>"
SVC_GID="<numeric gid of the service group>"
OPERATOR_USER="<the operator account that runs the scripts>"
W="<the window working directory (a new directory for this window)>"
SIGNER_UNIT="<the signer systemd unit name>"
CLAIM_UNIT="<the Claim payout systemd unit name>"
ORACLE_TIMER="<the oracle quote timer unit name>"
ORACLE_SERVICE="<the oracle quote service unit name>"
BEACON_URL="<local beacon REST URL on this host>"
# SHA-256 of the rendered 90 drop-in as REVIEWED (the review page lists it); the scripts render the repo template for this host and refuse a different result
DROPIN90_SHA="<64 hex characters>"
# SHA-256 of the host's own private files as REVIEWED (re-read by the pre-check, they must still match): the unit file, the current 90 drop-in, the three existing extra drop-ins, the Lab env file
UNIT_SHA="<64 hex characters>"
OLD_DROP_SHA="<64 hex characters>"
D91_SHA="<64 hex characters>"
D92_SHA="<64 hex characters>"
D93_SHA="<64 hex characters>"
ENV_SHA="<64 hex characters>"
