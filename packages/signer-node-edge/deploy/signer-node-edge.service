# Static HTTPS edge for the signer host.
# Listens on 443 only. It does not open port 80 and it does not serve a web root.
# Certificate files live under /var/lib/signer-node-edge, not a runtime directory.
# Install only after review. This file does not enable itself.

[Unit]
Description=Signer host HTTPS edge (static page and health)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signer-edge
Group=signer-edge
UMask=0077
WorkingDirectory=/opt/signer-node-edge
Environment=NODE_OPTIONS=
Environment=SIGNER_EDGE_HTTPS_PORT=443
Environment=SIGNER_EDGE_BIND=0.0.0.0
Environment=SIGNER_EDGE_CERT=/var/lib/signer-node-edge/current/fullchain.pem
Environment=SIGNER_EDGE_KEY=/var/lib/signer-node-edge/current/privkey.pem
Environment=SIGNER_EDGE_WORKERS=2
Environment=SIGNER_EDGE_CERT_POLL_MS=5000
ExecStart=/usr/bin/node --disable-sigusr1 --disallow-code-generation-from-strings /opt/signer-node-edge/src/edge.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @reboot @swap @module @raw-io
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/opt/wallet-signer -/srv/secure -/etc/wallet-signer -/run/wallet-signer -/run/wallet-signer-rpc -/run/wallet-signer-oracle
ReadOnlyPaths=/opt/signer-node-edge /var/lib/signer-node-edge
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
