	"dataDir": "/srv/secure/wallet-signer/state",
	"logDir": "/srv/secure/wallet-signer/log",
	"adminSocket": "/run/wallet-signer/admin.sock",
	"policyFile": "/etc/wallet-signer/policy.json",
	"compromisedFile": "/etc/wallet-signer/compromised.json",
	"rpc": {
		"proxied": {
			"path": "/run/wallet-signer-rpc/rpc.sock",
			"mode": 432
		}
