				"wallets": ["0x77CB8358c5a37aB7190b0A2C7EaA7fEeDCF11008"],
				"budgetWei": "600004200000",
				"minWei": "200001400000",
				"targetWei": "200001400000",
				"perAddressDailyWei": "200001400000",
				"globalDailyWei": "200001400000",
				"pmWarnWei": "5000000000000000000",
				"pmCriticalWei": "1000000000000000000"
			}
		}
	},
	"alerts": {
		"host": "wallet-signer",
		"webhookUrl": null
	},
	"scryptN": 262144,
	"keyWaitMs": 30000
}
